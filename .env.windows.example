# Windows (Docker Desktop + WSL2). Copy to .env:  Copy-Item .env.windows.example .env

# Load the Windows overrides on top of the base compose file.
COMPOSE_FILE=docker-compose.yml;docker-compose.windows.yml
COMPOSE_PATH_SEPARATOR=;

# Isolated ROS domain so we don't cross talk with other robots on the network.
ROS_DOMAIN_ID=77

# Ignition world: room (default, offline) | depot (downloads models from Fuel)
WORLD=room

# No GPU passthrough for OpenGL in Docker Desktop: software rendering (Mesa llvmpipe).
LIBGL_ALWAYS_SOFTWARE=1
