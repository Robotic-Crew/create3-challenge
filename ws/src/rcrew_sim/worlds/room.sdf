<?xml version="1.0"?>
<!-- Simple room for the Robotic Crew challenge: 8 x 6 m, pastel walls and a few
     colored obstacles so they stand out in both the lidar and the camera. -->
<sdf version="1.8">
  <world name="room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name="ignition::gazebo::systems::Physics" filename="ignition-gazebo-physics-system"/>
    <plugin name="ignition::gazebo::systems::UserCommands" filename="ignition-gazebo-user-commands-system"/>
    <plugin name="ignition::gazebo::systems::SceneBroadcaster" filename="ignition-gazebo-scene-broadcaster-system"/>
    <plugin name="ignition::gazebo::systems::Contact" filename="ignition-gazebo-contact-system"/>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.88 1.0 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.85 0.85 0.82 1</ambient>
            <diffuse>0.85 0.85 0.82 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 3.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.1 0.1 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8.1 0.1 0.8</size></box></geometry>
          <material><ambient>0.70 0.85 0.95 1</ambient><diffuse>0.70 0.85 0.95 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.1 0.1 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8.1 0.1 0.8</size></box></geometry>
          <material><ambient>0.95 0.80 0.70 1</ambient><diffuse>0.95 0.80 0.70 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>4.0 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 6.0 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.0 0.8</size></box></geometry>
          <material><ambient>0.75 0.92 0.75 1</ambient><diffuse>0.75 0.92 0.75 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-4.0 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 6.0 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.0 0.8</size></box></geometry>
          <material><ambient>0.93 0.87 0.75 1</ambient><diffuse>0.93 0.87 0.75 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="box_orange">
      <static>true</static>
      <pose>2.0 1.2 0.25 0 0 0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>1.0 0.55 0.15 1</ambient><diffuse>1.0 0.55 0.15 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="box_purple">
      <static>true</static>
      <pose>-2.2 -1.5 0.3 0 0 -0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.4 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.4 0.6</size></box></geometry>
          <material><ambient>0.60 0.45 0.85 1</ambient><diffuse>0.60 0.45 0.85 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="pillar_red">
      <static>true</static>
      <pose>1.8 -1.4 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.90 0.25 0.25 1</ambient><diffuse>0.90 0.25 0.25 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="pillar_teal">
      <static>true</static>
      <pose>-1.5 1.6 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.15 0.70 0.70 1</ambient><diffuse>0.15 0.70 0.70 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="divider">
      <static>true</static>
      <pose>0.0 -1.9 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 2.2 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 2.2 0.6</size></box></geometry>
          <material><ambient>0.95 0.85 0.30 1</ambient><diffuse>0.95 0.85 0.30 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
