# Copy to .env and adjust if needed.

# Isolated ROS domain so we don't cross talk with other robots on the network.
ROS_DOMAIN_ID=77

# Ignition world: room (default, offline) | depot (downloads models from Fuel)
WORLD=room

# Set to 1 if Gazebo won't open or freezes due to GPU drivers (software rendering, slower)
LIBGL_ALWAYS_SOFTWARE=0
