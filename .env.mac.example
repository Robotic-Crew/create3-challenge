# macOS (Docker Desktop). Copy to .env:  cp .env.mac.example .env

# Load the macOS overrides on top of the base compose file.
COMPOSE_FILE=docker-compose.yml:docker-compose.mac.yml

# Isolated ROS domain so we don't cross talk with other robots on the network.
ROS_DOMAIN_ID=77

# Ignition world: room (default, offline) | depot (downloads models from Fuel)
WORLD=room

# No GPU passthrough for OpenGL in Docker Desktop: software rendering (Mesa llvmpipe).
LIBGL_ALWAYS_SOFTWARE=1

# Size of the browser desktop (http://localhost:6080).
RESOLUTION=1920x1080
